{
	email aj@{$HOSTNAME}
}

{$HOSTNAME} {
	@health path /health
	handle @health {
		respond "ok" 200
	}

	# Grafana — observability dashboard.
	# `handle` (not `handle_path`) keeps the /graf prefix on the upstream
	# request — Grafana with serve_from_sub_path=true requires it.
	handle /graf/* {
		basic_auth {
			admin {$BASICAUTH_ADMIN_HASH}
		}
		reverse_proxy 127.0.0.1:3000
	}
	@graf_root path /graf
	handle @graf_root {
		redir /graf/ permanent
	}

	# mitmweb — egress audit UI.
	# mitmweb's DNS-rebinding guard rejects any Host: header that isn't an IP
	# or 'localhost'. We rewrite Host: 127.0.0.1:8081 before forwarding.
	handle_path /mitm/* {
		basic_auth {
			admin {$BASICAUTH_ADMIN_HASH}
		}
		reverse_proxy 127.0.0.1:8081 {
			header_up Host 127.0.0.1:8081
		}
	}
	@mitm_root path /mitm
	handle @mitm_root {
		redir /mitm/ permanent
	}

	# Hermes — agent web surface (the hermes-dashboard uvicorn app).
	# Hermes' dashboard supports sub-path serving via X-Forwarded-Prefix —
	# it then injects the prefix into asset URLs + __HERMES_BASE_PATH__.
	# Use `handle` (NOT `handle_path`) to KEEP the /hermes prefix so the
	# dashboard sees the URL it expects and the SPA's API calls also land
	# under /hermes/api/.
	# Host rewrite needed because the dashboard enforces Host: 127.0.0.1.
	handle /hermes/* {
		basic_auth {
			admin {$BASICAUTH_ADMIN_HASH}
		}
		reverse_proxy 127.0.0.1:8088 {
			header_up Host 127.0.0.1:8088
			header_up X-Forwarded-Prefix /hermes
		}
	}
	@hermes_root path /hermes
	handle @hermes_root {
		redir /hermes/ permanent
	}

	handle {
		respond "Hermes prototype OK" 200
	}
}
