{
	email aj@{$HOSTNAME}
}

{$HOSTNAME} {
	@health path /health
	handle @health {
		respond "ok" 200
	}

	# Grafana — observability dashboard.
	# `handle` (not `handle_path`) keeps the /graf prefix on the upstream
	# request — Grafana with serve_from_sub_path=true requires it.
	handle /graf/* {
		basic_auth {
			admin {$BASICAUTH_ADMIN_HASH}
		}
		reverse_proxy 127.0.0.1:3000
	}
	@graf_root path /graf
	handle @graf_root {
		redir /graf/ permanent
	}

	# mitmweb — egress audit UI.
	# mitmweb's frontend uses `location.origin + "/path"` for all API calls
	# and the /updates WebSocket. We route those root-relative paths here.
	# WebSocket: /updates is reached BEFORE basic_auth because browsers don't
	# send Authorization on the WS upgrade. The WS endpoint itself is bound
	# to 127.0.0.1 on the VM and only reachable via Caddy, so anyone hitting
	# /updates already went past TLS — acceptable tradeoff for a prototype.
	@mitm_ws path /updates
	handle @mitm_ws {
		reverse_proxy 127.0.0.1:8081 {
			header_up Host 127.0.0.1:8081
		}
	}
	@mitm_api path /flows /flows/* /commands /clear /options /filter-help /processes /static/* /dns-rebind
	handle @mitm_api {
		basic_auth {
			admin {$BASICAUTH_ADMIN_HASH}
		}
		reverse_proxy 127.0.0.1:8081 {
			header_up Host 127.0.0.1:8081
		}
	}
	handle_path /mitm/* {
		basic_auth {
			admin {$BASICAUTH_ADMIN_HASH}
		}
		reverse_proxy 127.0.0.1:8081 {
			header_up Host 127.0.0.1:8081
		}
	}
	@mitm_root path /mitm
	handle @mitm_root {
		redir /mitm/ permanent
	}

	# Hermes — agent web surface (the hermes-dashboard uvicorn app).
	# Hermes' dashboard registers routes at /api/... (no prefix). We must
	# STRIP the /hermes prefix before forwarding (handle_path does that)
	# AND send X-Forwarded-Prefix so the SPA's HTML rewrites still work
	# (asset paths + __HERMES_BASE_PATH__).
	# Host rewrite: dashboard enforces Host: 127.0.0.1 for CSRF.
	handle_path /hermes/* {
		basic_auth {
			admin {$BASICAUTH_ADMIN_HASH}
		}
		reverse_proxy 127.0.0.1:8088 {
			header_up Host 127.0.0.1:8088
			header_up X-Forwarded-Prefix /hermes
		}
	}
	@hermes_root path /hermes
	handle @hermes_root {
		redir /hermes/ permanent
	}

	handle {
		respond "Hermes prototype OK" 200
	}
}
