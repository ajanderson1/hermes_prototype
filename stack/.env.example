# Public hostname (Cloudflare A record points here)
HOSTNAME=hermes.example.com
OPERATOR_CIDRS=203.0.113.42/32

# Basic-auth credentials for Caddy walled routes (/graf, /mitm, /hermes).
# Generate with: docker run --rm caddy:2-alpine caddy hash-password -p 'yourpassword'
# Write the hash here with single '$' — scripts/encrypt-env.sh doubles them
# automatically before encryption so docker compose v2 doesn't interpolate.
BASICAUTH_ADMIN_HASH=$2a$14$replace_me_with_caddy_hash_password_output

# Hermes inference — OpenAI direct (use openrouter for Anthropic models)
OPENAI_API_KEY=sk-proj-replace-me
# Optional: OPENROUTER_API_KEY=sk-or-replace-me

# Hermes Telegram gateway — token from @BotFather
TELEGRAM_BOT_TOKEN=000000000:AA-replace-me
# Comma-separated Telegram numeric user IDs allowed to interact with the bot.
# Find yours by DM'ing @userinfobot.
TELEGRAM_ALLOWED_USERS=

# Hermes HITL (human-on-the-loop) — request approval before executing.
# Hermes-native: planning mode + per-tool approvals.
HERMES_APPROVAL_MODE=manual

# Default model. Cost-conscious default; override per-task via /model.
HERMES_DEFAULT_MODEL=openai/gpt-4o-mini
# Force OpenAI as the inference provider (otherwise Hermes auto-detects and
# may pick openrouter, which would need OPENROUTER_API_KEY).
HERMES_INFERENCE_PROVIDER=openai
HERMES_MODEL=openai/gpt-4o-mini
